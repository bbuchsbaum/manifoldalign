fit <- stimulus_sumcor_align(
  lapply(subjects, `[[`, "X"),
  design = lapply(subjects, `[[`, "design"),
  event_id = "event_id", repeat_id = "repeat_id",
  ncomp = 3,
  control = stimulus_sumcor_control(beta = 0, brain_rank = 10)
)
fit$component_agreement
